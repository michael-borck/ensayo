---
import "../styles/theme.css";
import company from "../data/company.json";

interface Props {
  title?: string;
  description?: string;
}
const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL;
const colors = (company as any).branding?.colors ?? {};
const primary = colors.primary ?? "#4a63e7";
const accent = colors.accent ?? "#00d4aa";
const secondary = colors.secondary ?? primary;

const pageTitle = title ? `${title} · ${company.name}` : company.name;
// Brand vars + a baseline accessibility layer (skip link + visible focus) shared
// by every company theme via this layout (WCAG 2.1 AA).
const css = `:root{--brand-primary:${primary};--brand-secondary:${secondary};--brand-accent:${accent};}
a.skip-link{position:absolute;left:-999px;top:0;z-index:100;padding:0.6rem 1rem;border-radius:0 0 8px 0;background:var(--brand-accent,#00d4aa);color:#04201a;font-weight:700;}
a.skip-link:focus{left:0;}
:focus-visible{outline:3px solid var(--brand-accent,#00d4aa);outline-offset:2px;}`;

// Globals for client scripts: where the VPS API lives (cross-origin on GitHub
// Pages; "" = same origin), this simulation's slug, and the owner slug
// (for account-scoped URLs: /sims/{owner}/{slug}/).
const apiBase = (company as any).apiBaseUrl ?? "";
const pathParts = Astro.url.pathname.split("/").filter(Boolean);
const ownerSlug = pathParts[0] === "sims" && pathParts.length >= 2 ? pathParts[1] : "";
const globals = `window.ENSAYO_API_BASE=${JSON.stringify(apiBase)};`
  + `window.ENSAYO_SIM_OWNER=${JSON.stringify(ownerSlug)};`
  + `window.ENSAYO_SIM_SLUG=${JSON.stringify(company.slug)};`;
const minors = (company as any).audience === "minors";

const nav = [
  { href: `${base}`, label: "Home" },
  { href: `${base}staff`, label: "Staff" },
  { href: `${base}docs`, label: "Documents" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description ?? company.tagline} />
    <style is:inline set:html={css}></style>
    <script is:inline set:html={globals}></script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href={base}>
          <span class="brand-mark">{company.name.charAt(0)}</span>
          <span class="brand-name">{company.name}</span>
        </a>
        <nav class="site-nav" aria-label="Primary">
          {nav.map((item) => <a href={item.href}>{item.label}</a>)}
        </nav>
      </div>
    </header>

    <main id="main-content" class="container site-main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <p>{company.name} — {company.location}</p>
        {minors && (
          <p class="muted">
            🛡 This is a safe learning environment. No personal information is
            collected, and chatbots are restricted to pre-set responses.
          </p>
        )}
        <p class="muted">
          A teaching simulation generated with Ensayo. Fictional organisation;
          all people and events are invented for educational use.
        </p>
      </div>
    </footer>
  </body>
</html>
