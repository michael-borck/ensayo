---
interface Props {
  slug: string;
  name: string;
  role: string;
  tier: string;
  background?: string;
}
const { slug, name, role, tier, background } = Astro.props;
const base = import.meta.env.BASE_URL;
const blurb = (background ?? "").split(/(?<=[.!?])\s+/).slice(0, 1).join(" ");
const initials = name
  .split(/\s+/)
  .map((p) => p.charAt(0))
  .slice(0, 2)
  .join("");
---

<a class="emp-card" href={`${base}staff/${slug}`}>
  <span class="emp-avatar">{initials}</span>
  <span class="emp-meta">
    <strong class="emp-name">{name}</strong>
    <span class="emp-role">{role}</span>
    <span class={`emp-tier tier-${tier}`}>{tier}</span>
    {blurb && <span class="emp-blurb">{blurb}</span>}
  </span>
</a>
