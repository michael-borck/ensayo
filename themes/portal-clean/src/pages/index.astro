---
import portal from "../data/portal.json";
const base = import.meta.env.BASE_URL;
const companies = (portal as any).companies ?? [];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{portal.title}</title>
    <meta name="description" content={portal.tagline} />
    <style is:inline set:html={`
      :root{color-scheme:dark;--bg:#0e1118;--surface:#161b26;--border:#2a3344;
        --text:#e7ecf3;--muted:#97a3b6;--accent:#00d4aa;--primary:#4a63e7;}
      *{box-sizing:border-box}
      body{margin:0;min-height:100vh;font-family:system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
        background:radial-gradient(1000px 560px at 75% -10%,color-mix(in srgb,var(--primary) 22%,transparent),transparent),var(--bg);
        color:var(--text);line-height:1.6;}
      .wrap{max-width:880px;margin:0 auto;padding:3rem 1.5rem 5rem;}
      .eyebrow{text-transform:uppercase;letter-spacing:0.14em;font-size:0.78rem;color:var(--accent);font-weight:700;margin:0;}
      h1{font-size:clamp(2.2rem,6vw,3.4rem);margin:0.2rem 0 0.4rem;}
      .lede{color:var(--muted);font-size:1.1rem;max-width:60ch;}
      .actions{display:flex;gap:0.8rem;flex-wrap:wrap;margin:1.6rem 0 0;}
      .btn{display:inline-block;padding:0.75rem 1.5rem;border-radius:11px;font-weight:600;border:1px solid transparent;}
      .btn-primary{background:linear-gradient(135deg,var(--primary),#6c63ff);color:#fff;text-decoration:none;}
      .btn-ghost{border-color:var(--border);color:var(--text);text-decoration:none;}
      .btn-ghost:hover{border-color:var(--accent);}
      h2{font-size:1.3rem;margin:2.6rem 0 1rem;}
      .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:1rem;}
      .card{display:flex;flex-direction:column;gap:0.25rem;padding:1.1rem 1.3rem;border:1px solid var(--border);
        border-radius:14px;background:var(--surface);color:inherit;text-decoration:none;}
      .card:hover{border-color:var(--accent);}
      .card strong{font-size:1.1rem;} .card span{color:var(--muted);}
      footer{color:var(--muted);font-size:0.9rem;margin-top:3rem;}
    `}></style>
  </head>
  <body>
    <div class="wrap">
      <p class="eyebrow">{portal.name}</p>
      <h1>{portal.title}</h1>
      <p class="lede">{portal.tagline}</p>
      <div class="actions">
        <a class="btn btn-primary" href={portal.portalAppUrl}>Sign in to your portal →</a>
        <a class="btn btn-ghost" href={portal.jobsUrl}>Browse {portal.jobsCount} open roles</a>
      </div>

      <h2>Participating organisations</h2>
      <div class="grid">
        {companies.map((c: any) => (
          <a class="card" href={c.url}>
            <strong>{c.name}</strong>
            <span>{c.tagline}</span>
          </a>
        ))}
      </div>

      <footer>
        A teaching simulation generated with Ensayo. Fictional organisations; all
        people and events are invented for educational use.
      </footer>
    </div>
  </body>
</html>
