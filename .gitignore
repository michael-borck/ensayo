# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/

# Node / Astro (themes vendor these; not committed). Bare form also ignores the
# per-theme node_modules symlinks used for fast local builds.
node_modules
.astro/

# Generator output
dist/
dist-out/
.ensayo-build/
out/

# API runtime data (SQLite DB + working clones)
.ensayo-data/

# Local config (secrets + instance settings)
.env
instance.env

# A11y audit deps (created by running scripts/a11y/audit.mjs)
scripts/a11y/package.json
scripts/a11y/package-lock.json

# OS
.DS_Store
._*          # macOS AppleDouble metadata (exFAT/external volumes)
**/._*
