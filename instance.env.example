# Ensayo instance configuration — "what runs where".
# Safe to review and share. Copy to instance.env. (spec §5.6)

ENSAYO_DOMAIN=localhost
ADMIN_EMAIL=admin@example.edu
BASE_URL=http://localhost:8080

# Host port mapped to the container's :80 (see docker-compose.yml).
ENSAYO_HTTP_PORT=8080

# Where the dashboard keeps git working clones (Phase 3+).
WORKING_CLONES_DIR=/var/ensayo/sims
