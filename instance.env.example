# Ensayo instance configuration. Copy to instance.env and fill in.
# Required for a working deploy: JWT_SECRET + an email provider + ALLOWED_DOMAINS.

ENSAYO_DOMAIN=localhost
ADMIN_EMAIL=admin@example.edu
BASE_URL=http://localhost:8080
# Host port mapped to the container's :80 (see docker-compose.yml).
ENSAYO_HTTP_PORT=8080

# --- Auth (REQUIRED) ---
# A strong random string (>= 32 chars). `openssl rand -hex 32`.
JWT_SECRET=change-me-to-32-or-more-random-characters

# --- Email (verification + password-reset codes) ---
# Pick one provider. Without one, codes surface in the dashboard admin panel.
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM=Ensayo <noreply@your-verified-domain.com>
# EMAIL_PROVIDER=console            # dev: codes logged / shown in admin panel
# EMAIL_PROVIDER=smtp               # any SMTP relay (Gmail/SendGrid/institutional)
# SMTP_HOST= SMTP_PORT=465 SMTP_SSL=true SMTP_USER= SMTP_PASSWORD= EMAIL_FROM=

# --- Self-registration ---
# Restrict sign-ups to these email domains (comma-separated). Empty = open to all.
ALLOWED_DOMAINS=curtin.edu.au

# --- Build load (demo safety) ---
# Max concurrent sim builds; extras defer. Default 2.
MAX_CONCURRENT_BUILDS=2

# Per-account simulation limit. Default 3.
# MAX_SIMS_PER_UC=3

# AnythingLLM (per-persona RAG chatbots). Leave unset for keyword-only.
# ANYTHINGLLM_URL=http://anythingllm:3001
# ANYTHINGLLM_API_KEY=your-key
# Comma-separated domains allowed to use embed widgets (cross-origin booking).
# ANYTHINGLLM_ALLOWLIST_DOMAINS=ensayo.locoensayo.org

# Data persistence: set to bind-mount an existing bare-metal data directory.
# Leave unset for a clean Docker named volume.
# DATA_DIR=./.ensayo-data

# Runtime data path. In docker-compose this is overridden to the persisted volume.
WORKING_CLONES_DIR=/var/ensayo/sims
