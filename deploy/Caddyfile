# Ensayo — Tier 1 (zero-config demo) Caddy config.
#
# Path-based fallback routing: every simulation is served under /sims/{slug}/
# with no DNS required (spec §5.7). Tier 2/3 swap this for a domain block with
# automatic TLS; that's a Caddy change, not an application change.

{
	admin off
	auto_https off
}

:80 {
	encode gzip
	root * /srv/www
	file_server

	# Friendly 404 → back to the index of simulations.
	handle_errors {
		@404 expression {http.error.status_code} == 404
		rewrite @404 /index.html
		file_server
	}
}
