# Ensayo secrets — credentials only. NEVER commit. Copy to .env. (spec §5.6)

# LLM provider. "stub" needs no key and powers the zero-config demo.
# Options: stub | ollama | lmstudio | openai | openrouter | gemini | anthropic
LLM_PROVIDER=stub
# LLM_MODEL=claude-sonnet-4-6

# --- API keys (only the one matching LLM_PROVIDER is needed) ---
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=
# OLLAMA_API_KEY=

# --- Dashboard / git push (Phase 3) ---
# GITHUB_TOKEN=
# JWT_SECRET=change-me

# --- AnythingLLM (per-persona RAG chatbots) ---
# ANYTHINGLLM_API_KEY=
# ANYTHINGLLM_URL=http://anythingllm:3001
# Comma-separated domains allowed to use embed widgets (cross-origin booking).
# ANYTHINGLLM_ALLOWLIST_DOMAINS=ensayo.locoensayo.org

# --- Self-registration (lecturer sign-up) ---
# Comma-separated allowed email domains. Empty = open to ANY domain (dev only).
# Set this on a public instance. Lecturers register → emailed 6-digit code →
# verify → log in. Registration can be opened/closed live from the dashboard's
# Instance admin panel (no restart needed).
# Without a real provider (below), verification + password-reset codes are shown
# in the dashboard's "Users & pending verification codes" panel for an admin to
# relay by hand. Pick ONE provider and set its vars:

# EMAIL_PROVIDER=console            # dev: log to stdout (default)
# EMAIL_PROVIDER=smtp               # any SMTP relay (Gmail/SendGrid/Brevo/institutional)
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_SSL=true                     # port 465 uses implicit TLS; omit for 587+STARTTLS
# SMTP_USER=resend
# SMTP_PASSWORD=re_xxxxxxxx         # Resend: your API key is the SMTP password
# EMAIL_FROM=Ensayo <noreply@yourdomain.com>

# EMAIL_PROVIDER=resend             # Resend REST API (recommended for a public demo)
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM=Ensayo <noreply@yourdomain.com>

# Verify delivery once configured:  ensayo admin send-test-email --to you@curtin.edu.au

# --- Build load (demo safety) ---
# Max concurrent sim builds (each is ~15-90s of CPU). Extras defer and show as
# "build deferred — click Regenerate". Caps a flood of lecturers from exhausting
# MAX_CONCURRENT_BUILDS=2

# --- Per-account sim limit ---
# Default 3. Lecturers see "X of N used" in the dashboard.
# MAX_SIMS_PER_UC=3
